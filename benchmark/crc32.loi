import "../lib/crc32.loi"

// Reflected nibble CRC-32 over a fixed 64 KiB buffer, repeated 1024 times.
open flow main
    => i32
{
    protect {
        mut data: [u8]
        alloc(-> data, u8, 65536)
        for i in 0..data.len {
            data[i] = ((i * 97 + 13) % 251) as u8
        }

        mut state: u32 <- CRC32_INIT
        mut round: u64 <- 0
        while round < 1024 {
            state = crc32_update(state, data)
            round += 1
        }
        result <- state ^ CRC32_XOROUT
        printf("crc32 %llu %llu\n", result as u64, data[65535] as u64)
    }
    => 0
}
