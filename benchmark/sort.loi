import "../lib/vec.loi"

// Sixteen heapsorts of a freshly generated 65,536-element i32 vector.
open flow main
    => i32
{
    protect {
        mut seed_values: [i32]
        alloc(-> seed_values, i32, 65536)
        for i in 0..seed_values.len {
            seed_values[i] = 0
        }
        mut values: Vec<i32>
        vec_from_slice<i32>(seed_values, -> values)
        mut state: u64 <- 0x1234_5678_9abc_def0
        mut round: u64 <- 0
        while round < 16 {
            state = 0x1234_5678_9abc_def0 + round * 0x9e37_79b9_7f4a_7c15
            for i in 0..values.len {
                state ^= state << 13
                state ^= state >> 7
                state ^= state << 17
                values.data[i] = (state % 1000003) as i32
            }
            vec_sort<i32>(<-> values)
            round += 1
        }
        mut checksum: u64 <- 0
        for i in 0..values.len {
            checksum += values.data[i] as u64 * (i % 97 + 1)
        }
        printf("sort %llu %llu\n", checksum, values.len)
    }
    => 0
}
