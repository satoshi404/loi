shape Item [ value: i32 ]

sealed flow sum_items
    <- items: [Item]
    <- n: u32
    => i32
{
    mut total: i32 <- 0
    for <- item in items {
        total += item.value
    }
    => total
}

sealed flow double_items
    <-> items: [Item]
    <- n: u32
{
    for <-> item in items {
        item.value *= 2
    }
}

open flow main
    => i32
{
    protect {
        mut items: [Item]
        alloc(-> items, Item, 4)
        items[0] = Item[ value: 1 ]
        items[1] = Item[ value: 2 ]
        items[2] = Item[ value: 3 ]
        items[3] = Item[ value: 4 ]

        mut s: i32 <- sum_items(items, 4)
        if s != 10 {
            => 3
        }

        double_items(<-> items, 4)

        s = sum_items(items, 4)
        if s != 20 {
            => 4
        }
    }
    => 0
}
