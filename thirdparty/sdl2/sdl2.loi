// ---- Structs and unions ----
struct _SDL_iconv_t { char _opaque; }   // opaque: use through pointers
struct AssertData {
    int always_ignore;
    unsigned int trigger_count;
    char* condition;
    char* filename;
    int linenum;
    char* func_name;
    AssertData* next;
}
struct atomic_t {
    int value;
}
struct mutex { char _opaque; }   // opaque: use through pointers
struct sem { char _opaque; }   // opaque: use through pointers
struct cond { char _opaque; }   // opaque: use through pointers
struct Thread { char _opaque; }   // opaque: use through pointers
struct RWops_hidden_stdio {
    bool_ autoclose;
    void* fp;
}
struct RWops_hidden_mem {
    Uint8* base;
    Uint8* here;
    Uint8* stop;
}
struct RWops_hidden_unknown {
    void* data1;
    void* data2;
}
union RWops_hidden {
    RWops_hidden_stdio stdio;
    RWops_hidden_mem mem;
    RWops_hidden_unknown unknown;
}
struct RWops {
    void* size;
    void* seek;
    void* read;
    void* write;
    void* close;
    Uint32 type_;
    RWops_hidden hidden;
}
struct AudioSpec {
    int freq;
    AudioFormat format;
    Uint8 channels;
    Uint8 silence;
    Uint16 samples;
    Uint16 padding;
    Uint32 size;
    AudioCallback callback;
    void* userdata;
}
struct AudioCVT @pack() {
    int needed;
    AudioFormat src_format;
    AudioFormat dst_format;
    double rate_incr;
    Uint8* buf;
    int len;
    int len_cvt;
    int len_mult;
    double len_ratio;
    AudioFilter[10] filters;
    int filter_index;
}
struct AudioStream { char _opaque; }   // opaque: use through pointers
struct Color {
    Uint8 r;
    Uint8 g;
    Uint8 b;
    Uint8 a;
}
struct Palette {
    int ncolors;
    Color* colors;
    Uint32 version;
    int refcount;
}
struct PixelFormat {
    Uint32 format;
    Palette* palette;
    Uint8 BitsPerPixel;
    Uint8 BytesPerPixel;
    Uint8[2] padding;
    Uint32 Rmask;
    Uint32 Gmask;
    Uint32 Bmask;
    Uint32 Amask;
    Uint8 Rloss;
    Uint8 Gloss;
    Uint8 Bloss;
    Uint8 Aloss;
    Uint8 Rshift;
    Uint8 Gshift;
    Uint8 Bshift;
    Uint8 Ashift;
    int refcount;
    PixelFormat* next;
}
struct Point {
    int x;
    int y;
}
struct FPoint {
    float x;
    float y;
}
struct Rect {
    int x;
    int y;
    int w;
    int h;
}
struct FRect {
    float x;
    float y;
    float w;
    float h;
}
struct BlitMap { char _opaque; }   // opaque: use through pointers
struct Surface {
    Uint32 flags;
    PixelFormat* format;
    int w;
    int h;
    int pitch;
    void* pixels;
    void* userdata;
    int locked;
    void* list_blitmap;
    Rect clip_rect;
    BlitMap* map;
    int refcount;
}
struct DisplayMode {
    Uint32 format;
    int w;
    int h;
    int refresh_rate;
    void* driverdata;
}
struct Window { char _opaque; }   // opaque: use through pointers
struct Keysym {
    Scancode scancode;
    Keycode sym;
    Uint16 mod;
    Uint32 unused;
}
struct Cursor { char _opaque; }   // opaque: use through pointers
struct GUID {
    Uint8[16] data;
}
struct Joystick { char _opaque; }   // opaque: use through pointers
struct VirtualJoystickDesc {
    Uint16 version;
    Uint16 type_;
    Uint16 naxes;
    Uint16 nbuttons;
    Uint16 nhats;
    Uint16 vendor_id;
    Uint16 product_id;
    Uint16 padding;
    Uint32 button_mask;
    Uint32 axis_mask;
    char* name;
    void* userdata;
