@package(tests_06_struct_layout)
/* struct layout control: @pack shrinks, @align(n) raises, natural padding */
struct Natural { char c; int i; }
struct Packed  @pack() { char c; int i; }
struct Aligned @align(8) { char c; }

main = () -> int {
    int nat = @sizeof(Natural);   /* 8 (padded to 4 then 8) */
    int pac = @sizeof(Packed);    /* 5 (tight)             */
    int aln = @alignof(Aligned);  /* 8 (@align)            */
    return nat + pac + aln;       /* 21 */
}
