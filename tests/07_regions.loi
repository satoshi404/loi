@package(tests_07_regions)
@inc std

/* lexical regions: bump allocator, valid inside the block */
main = () -> int {
    int got = 0;
    region r(64) {
        void* a = std.region_alloc(r, 8);
        void* b = std.region_alloc(r, 8);
        *a = 21;
        *b = 21;
        got = *a + *b;      /* 42 */
    }
    return got;             /* 42 */
}
