package tests_13_macros_trio

@inc std
/* macro trio: @stringify, @paste and variadic macros */
@(define STR(x) @stringify(x))
@(define CONCAT(a, b) @paste(a, b))
@(define LIMIT 8)
@(define LOG(level, ...msg) { @if(level >= 1) { std.print_str(msg); } })

int foobar = 77;

main = () -> int !IO
{
    std.print_str(STR(hello));        /* hello   */
    std.print_str(STR(LIMIT));        /* LIMIT   */
    int foo = 1;
    int bar = 2;
    LOG(1, "variadic ok\n");
    return CONCAT(foo, bar);          /* 77 */
}
