@package(tests_05_reflection)
/* compile-time reflection: sizeof, alignof, offsetof, typeof */
struct Point { int x; int y; double z; }
struct Packed @pack() { char c; int i; }

main = () -> int {
    int sz   = @sizeof(Point);      /* 16 */
    int offz = @offsetof(Point, z); /*  8 */
    int algn = @alignof(Point);     /*  8 */
    int psz  = @sizeof(Packed);     /*  5 */
    @typeof(sz) copy = sz;
    return sz + offz + algn + psz + copy;  /* 16+8+8+5+16 = 53 */
}
