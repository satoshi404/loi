@package(tests_17_effects_fnptr_drop_fail)
@inc std

/* effects: storing an !IO function where a pure fn type is expected
   must be rejected (via a variable initializer). */
type PureFn = () -> void;
io = (): void !IO { std.print_str("x\n"); }
main = () -> int
{
    f: PureFn = io;   /* must fail: drops !IO */
    return 0;
}
