// ---------------------------------------------------------------------------
// Task mutators.
// ---------------------------------------------------------------------------
open flow add_task_input
    <-> p: Project
    <- index: u64
    <- path: [u8]
{
    model_check_index(index, p.tasks.len)
    model_require_path(path, "task input")
    mut item <- vec_get<BuildTask>(p.tasks, index)
    vec_push<[u8]>(<-> item.inputs, path)
    vec_set<BuildTask>(<-> p.tasks, index, item)
}

open flow add_task_output
    <-> p: Project
    <- index: u64
    <- path: [u8]
{
    model_check_index(index, p.tasks.len)
    model_require_path(path, "task output")
    mut item <- vec_get<BuildTask>(p.tasks, index)
    vec_push<[u8]>(<-> item.outputs, path)
    vec_set<BuildTask>(<-> p.tasks, index, item)
}

open flow add_task_dep
    <-> p: Project
    <- index: u64
    <- dep_id: [u8]
{
    model_check_index(index, p.tasks.len)
    model_require_id(dep_id, "task dependency")
    mut item <- vec_get<BuildTask>(p.tasks, index)
    vec_push<[u8]>(<-> item.deps, dep_id)
    vec_set<BuildTask>(<-> p.tasks, index, item)
}

/// Select the native action of a task. Only structured names are accepted; the
/// validator rejects anything outside the closed vocabulary. No string is ever
/// interpreted as a shell command.
open flow set_task_action
    <-> p: Project
    <- index: u64
    <- value: [u8]
{
    model_check_index(index, p.tasks.len)
    model_require_id(value, "task action")
    mut item <- vec_get<BuildTask>(p.tasks, index)
    item.action = clone(value)
    vec_set<BuildTask>(<-> p.tasks, index, item)
}

/// Literal bytes used by the `write` action.
open flow set_task_content
    <-> p: Project
    <- index: u64
    <- value: [u8]
{
    model_check_index(index, p.tasks.len)
    mut item <- vec_get<BuildTask>(p.tasks, index)
    item.content = clone(value)
    vec_set<BuildTask>(<-> p.tasks, index, item)
}

/// `changed` uses the task manifest, `always` reruns on every invocation.
open flow set_task_condition
    <-> p: Project
    <- index: u64
    <- value: [u8]
{
    model_check_index(index, p.tasks.len)
    model_require_id(value, "task condition")
    mut item <- vec_get<BuildTask>(p.tasks, index)
    item.condition = clone(value)
    vec_set<BuildTask>(<-> p.tasks, index, item)
}
