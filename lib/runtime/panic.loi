//! Named panic entry points for runtime and library diagnostics.
//!
//! Re-exported by `lib/runtime.loi`. The intrinsic `panic` stays visible; these
//! are thin wrappers with assert-style names, not a replacement for `guard`.

open flow runtime_panic
    <- message: [u8]
{
    panic(message)
}

open flow runtime_assert
    <- condition: bool
    <- message: [u8]
{
    if not condition {
        panic(message)
    }
}

open flow runtime_assert_i64_eq
    <- actual: i64
    <- expected: i64
    <- message: [u8]
{
    if actual != expected {
        panic(message)
    }
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `runtime_assert`.
open flow assert
<- condition: bool
<- message: [u8]
{
    runtime_assert(condition, message)
}

/// Short alias of `runtime_assert_i64_eq`.
open flow assert_i64_eq
<- actual: i64
<- expected: i64
<- message: [u8]
{
    runtime_assert_i64_eq(actual, expected, message)
}
