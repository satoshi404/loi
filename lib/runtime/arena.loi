//! Arena-facing helpers for the generated Loi runtime.
//!
//! Re-exported by `lib/runtime.loi`. A caller must still write `protect { ... }`
//! around any flow that allocates; this module only names common patterns and
//! never hides the arena or the `alloc` intrinsic.

/// Allocate a byte slice in the active `protect` region.
open flow arena_bytes
    -> out: [u8]
    <- count: u64
{
    alloc(-> out, u8, count)
}

/// Allocate and fill a byte slice in the active `protect` region.
open flow arena_filled_bytes
    -> out: [u8]
    <- count: u64
    <- byte: u8
{
    if count == 0 {
        out = [u8:]
        =>
    }
    alloc(-> out, u8, count)
    for i in 0..count {
        out[i] = byte
    }
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `arena_filled_bytes`.
open flow filled_bytes
-> out: [u8]
<- count: u64
<- byte: u8
{
    arena_filled_bytes(-> out, count, byte)
}
