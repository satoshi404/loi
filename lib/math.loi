//! Pure math package: constants, generic helpers, float and integer utilities.
//!
//! ```loi
//! import "lib/math.loi"           // broad package import
//! import "lib/math/float.loi"     // fine-grained import
//!
//! half <- math::math_lerp(0.0, 1.0, 0.5)
//! ```
//!
//! No I/O, no allocation and no C shim live in `math`.

open import "math/const.loi"
open import "math/generic.loi"
open import "math/float.loi"
open import "math/integer.loi"
