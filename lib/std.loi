//! Everyday utilities for Loi tools and applications.
//!
//! ```loi
//! import "lib/std.loi"           // broad package import
//! import "lib/std/fmt.loi"       // narrow import
//!
//! text <- std::str_concat("a", "b")
//! ```
//!
//! This root re-exports the package's public surface with `open import`.
//! Internal files are grouped by theme; there is no single `std` monolith.
//! `std` depends on `core` by convention and never imports `os` or `net`.

open import "std/num.loi"
open import "std/convert.loi"
open import "std/str.loi"
open import "std/vec.loi"
open import "std/slice.loi"
open import "std/map.loi"
open import "std/hash.loi"
open import "std/crc32.loi"
open import "std/random.loi"
open import "std/ctype.loi"
open import "std/fmt.loi"
open import "std/debug.loi"
open import "std/iter.loi"
