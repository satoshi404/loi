//! Byte-string helpers written in Loi.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/string.loi"
//! ```
//!
//! Strings are `[u8]`. Transforming flows are `open` public APIs, but they
//! still allocate in the caller's `protect` region; query flows are `open` and
//! need no region. Names avoid the helpers in `lib/std.loi` and
//! `lib/ctype.loi`.

open STRING_MAX_LEN: u64 <- 18446744073709551615

open flow str_is_ascii_space
    <- byte: u8
    => bool
{
    => byte == 32 or byte == 9 or byte == 10 or byte == 13
}

open flow str_trim
    <- text: [u8]
    => [u8]
{
    mut start: u64 <- 0
    while start < text.len and str_is_ascii_space(text[start]) {
        start += 1
    }
    mut end: u64 <- text.len
    while end > start and str_is_ascii_space(text[end - 1]) {
        end -= 1
    }
    count <- end - start
    mut out: [u8]
    alloc(-> out, u8, count)
    for i in 0..count {
        out[i] = text[start + i]
    }
    => give(out)
}

open flow str_concat
    <- left: [u8]
    <- right: [u8]
    => [u8]
{
    if left.len > STRING_MAX_LEN - right.len {
        panic("str_concat: inputs are too large\n")
    }
    total <- left.len + right.len
    mut out: [u8]
    alloc(-> out, u8, total)
    for i in 0..left.len {
        out[i] = left[i]
    }
    for i in 0..right.len {
        out[left.len + i] = right[i]
    }
    => give(out)
}

open flow str_reverse
    <- text: [u8]
    => [u8]
{
    mut out: [u8]
    alloc(-> out, u8, text.len)
    for i in 0..text.len {
        out[text.len - 1 - i] = text[i]
    }
    => give(out)
}

open flow str_repeat
    <- text: [u8]
    <- count: u64
    => [u8]
{
    if count == 0 {
        mut empty: [u8]
        alloc(-> empty, u8, 0)
        => give(empty)
    }
    limit <- STRING_MAX_LEN / count
    if text.len > limit {
        panic("str_repeat: count is too large\n")
    }
    total <- text.len * count
    mut out: [u8]
    alloc(-> out, u8, total)
    mut at: u64 <- 0
    mut copied: u64 <- 0
    while copied < count {
        for i in 0..text.len {
            out[at] = text[i]
            at += 1
        }
        copied += 1
    }
    => give(out)
}

open flow str_count
    <- text: [u8]
    <- byte: u8
    => u64
{
    mut total: u64 <- 0
    for i in 0..text.len {
        if text[i] == byte {
            total += 1
        }
    }
    => total
}

open flow str_index_of
    <- text: [u8]
    <- needle: [u8]
    => i64
{
    if needle.len == 0 {
        => 0
    }
    if needle.len > text.len {
        => -1
    }
    for i in 0..(text.len - needle.len + 1) {
        mut matches: bool <- true
        for j in 0..needle.len {
            if text[i + j] != needle[j] {
                matches = false
                break
            }
        }
        if matches {
            => i as i64
        }
    }
    => -1
}

open flow str_contains
    <- text: [u8]
    <- needle: [u8]
    => bool
{
    => str_index_of(text, needle) >= 0
}
