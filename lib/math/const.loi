//! Compile-time math constants and factorial.
//!
//! Re-exported by `lib/math.loi`; import this file directly for a narrow build.

open MATH_PI: f64 <- 3.141592653589793

open MATH_E: f64 <- 2.718281828459045

open MATH_TAU: f64 <- comptime 2.0 * MATH_PI

/// Compile-time factorial; usable in globals and `comptime` expressions.
open comptime flow math_factorial
    <- n: u32
    => u64
{
    mut result: u64 <- 1
    mut i: u32 <- 2
    while i <= n {
        result *= i as u64
        i += 1
    }
    => result
}
