//! Integer sign, GCD and exponentiation helpers.
//!
//! Re-exported by `lib/math.loi`; import this file directly for a narrow build.
open flow math_sign_i32
    <- value: i32
    => i32
{
    if value < 0 {
        => -1
    }
    if value > 0 {
        => 1
    }
    => 0
}

/// Greatest common divisor. Both zero arguments produce zero.
open flow math_gcd_u64
    <- a: u64
    <- b: u64
    => u64
{
    mut x: u64 <- a
    mut y: u64 <- b
    while y != 0 {
        remainder <- x % y
        x = y
        y = remainder
    }
    => x
}

/// Exponentiation by squaring. Unsigned overflow wraps, as in Loi arithmetic.
open flow math_pow_u64
    <- base: u64
    <- exponent: u32
    => u64
{
    mut result: u64 <- 1
    mut factor: u64 <- base
    mut power: u32 <- exponent
    while power > 0 {
        if power & 1 != 0 {
            result *= factor
        }
        factor *= factor
        power >>= 1
    }
    => result
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `math_sign_i32`.
open flow sign_i32
<- value: i32
=> i32
{
    => math_sign_i32(value)
}

/// Short alias of `math_gcd_u64`.
open flow gcd_u64
<- a: u64
<- b: u64
=> u64
{
    => math_gcd_u64(a, b)
}

/// Short alias of `math_pow_u64`.
open flow pow_u64
<- base: u64
<- exponent: u32
=> u64
{
    => math_pow_u64(base, exponent)
}
