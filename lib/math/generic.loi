//! Generic selection and slice helpers over `T: Copy`.
//!
//! Re-exported by `lib/math.loi`; import this file directly for a narrow build.
open flow math_min<T: Copy>
    <- a: T
    <- b: T
    => T
{
    if a < b {
        => a
    }
    => b
}

open flow math_max<T: Copy>
    <- a: T
    <- b: T
    => T
{
    if a > b {
        => a
    }
    => b
}

open flow math_clamp<T: Copy>
    <- value: T
    <- low: T
    <- high: T
    => T
{
    if value < low {
        => low
    }
    if value > high {
        => high
    }
    => value
}

/// Sum every element of a slice; the element type is supplied explicitly.
open flow math_sum<T: Copy>
    <- xs: [T]
    => T
{
    mut total: T <- 0
    for i in 0..xs.len {
        total += xs[i]
    }
    => total
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `math_min`.
open flow min<T: Copy>
<- a: T
<- b: T
=> T
{
    => math_min<T>(a, b)
}

/// Short alias of `math_max`.
open flow max<T: Copy>
<- a: T
<- b: T
=> T
{
    => math_max<T>(a, b)
}

/// Short alias of `math_clamp`.
open flow clamp<T: Copy>
<- value: T
<- low: T
<- high: T
=> T
{
    => math_clamp<T>(value, low, high)
}

/// Short alias of `math_sum`.
open flow sum<T: Copy>
<- xs: [T]
=> T
{
    => math_sum<T>(xs)
}
