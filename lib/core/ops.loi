//! Minimal integer and marker utilities shared by higher packages.
//!
//! Re-exported by `lib/core.loi`. Pure Loi, no allocation and no foreign calls.

open flow ops_is_power_of_two_u64
    <- value: u64
    => bool
{
    if value == 0 {
        => false
    }
    => value & (value - 1) == 0
}

/// Round up to a power of two. Zero maps to one so callers can reserve safely.
open flow ops_next_power_of_two_u64
    <- value: u64
    => u64
{
    if value <= 1 {
        => 1
    }
    mut result: u64 <- 1
    while result < value {
        result <<= 1
    }
    => result
}

/// Saturating subtraction: zero instead of an unsigned wrap.
open flow ops_saturating_sub_u64
    <- left: u64
    <- right: u64
    => u64
{
    if right > left {
        => 0
    }
    => left - right
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `ops_is_power_of_two_u64`.
open flow is_power_of_two_u64
<- value: u64
=> bool
{
    => ops_is_power_of_two_u64(value)
}

/// Short alias of `ops_next_power_of_two_u64`.
open flow next_power_of_two_u64
<- value: u64
=> u64
{
    => ops_next_power_of_two_u64(value)
}

/// Short alias of `ops_saturating_sub_u64`.
open flow saturating_sub_u64
<- left: u64
<- right: u64
=> u64
{
    => ops_saturating_sub_u64(left, right)
}
