//! Optional values written in pure Loi.
//!
//! `Option<T>` is a generic shape: `present` says whether `value` holds a
//! value. It is deliberately a shape, not a `choice`: Loi choices are not
//! generic and their payloads cannot contain slices, while a shape can hold
//! any `T` that the caller can clone. There is no `nil`; an absent option
//! still carries a zero-initialized `value` that must not be read directly.
//! Use `option_get_or` or `option_unwrap` instead.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/option.loi"
//! ```
open shape Option<T> {
    present: bool = false
    value: T
}

/// Build an absent option. `value` is zero-initialized; never read it.
open flow option_none<T>
    -> out: Option<T>
{
}

/// Build a present option. Cloning `value` needs a caller `protect` when `T`
/// contains slices.
open flow option_some<T: Clone>
    <- value: T
    -> out: Option<T>
{
    out.present = true
    out.value = clone(value)
}

open flow option_is_some<T>
    <- opt: Option<T>
    => bool
{
    => opt.present
}

open flow option_is_none<T>
    <- opt: Option<T>
    => bool
{
    => not opt.present
}

/// Return the stored value or `fallback`, cloning either one.
open flow option_get_or<T: Clone>
    <- opt: Option<T>
    <- fallback: T
    => T
{
    if opt.present {
        => clone(opt.value)
    }
    => clone(fallback)
}

/// Return the stored value or abort with a flow-naming message.
open flow option_unwrap<T: Clone>
    <- opt: Option<T>
    => T
{
    if not opt.present {
        panic("option_unwrap: no value\n")
    }
    => clone(opt.value)
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `option_none`.
open flow none<T>
-> out: Option<T>
{
    option_none<T>(-> out)
}

/// Short alias of `option_some`.
open flow some<T: Clone>
<- value: T
-> out: Option<T>
{
    option_some<T>(value, -> out)
}

/// Short alias of `option_is_some`.
open flow is_some<T>
<- opt: Option<T>
=> bool
{
    => option_is_some<T>(opt)
}

/// Short alias of `option_is_none`.
open flow is_none<T>
<- opt: Option<T>
=> bool
{
    => option_is_none<T>(opt)
}

/// Short alias of `option_get_or`.
open flow get_or<T: Clone>
<- opt: Option<T>
<- fallback: T
=> T
{
    => option_get_or<T>(opt, fallback)
}

/// Short alias of `option_unwrap`.
open flow unwrap<T: Clone>
<- opt: Option<T>
=> T
{
    => option_unwrap<T>(opt)
}
