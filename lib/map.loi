//! Arena-backed hash-free maps written in Loi.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/map.loi"
//! ```
//!
//! `IntMap<V>` is keyed by `u64`; `StrMap<V>` is keyed by byte-slice keys. Both
//! are generic only over the value type. Flows that copy values declare
//! `V: Clone`; every Loi type satisfies it, but cloning a value containing
//! slices allocates and still needs the caller's `protect` region.
//! Allocating flows are `open` public APIs, but callers must provide a
//! `protect` region. Lookups are linear scans; this trades asymptotic speed
//! for a small, fully checked implementation with no hidden hash collisions.
//! `map_*_lookup` returns both a status and a caller-supplied default in one
//! scan, and `map_*_get_or` is the value-only form.
open MAP_INITIAL_CAP: u64 <- 8

open MAP_INITIAL_KEY_BYTES: u64 <- 64

// ---------------------------------------------------------------------------
// IntMap<V>
// ---------------------------------------------------------------------------
open shape IntMap<V> {
    keys: [u64]
    values: [V]
    len: u64
    cap: u64
}

open flow map_int_new<V>
    -> m: IntMap<V>
{
    alloc(-> m.keys, u64, MAP_INITIAL_CAP)
    alloc(-> m.values, V, MAP_INITIAL_CAP)
    m.len = 0
    m.cap = MAP_INITIAL_CAP
}

open flow map_int_len<V>
    <- m: IntMap<V>
    => u64
{
    => m.len
}

open flow map_int_capacity<V>
    <- m: IntMap<V>
    => u64
{
    => m.cap
}

flow map_int_find<V>
    <- m: IntMap<V>
    <- key: u64
    => i64
{
    for i in 0..m.len {
        if m.keys[i] == key {
            => i as i64
        }
    }
    => -1
}

open flow map_int_contains<V>
    <- m: IntMap<V>
    <- key: u64
    => bool
{
    => map_int_find<V>(m, key) >= 0
}

open flow map_int_get<V: Clone>
    <- m: IntMap<V>
    <- key: u64
    => V
{
    at <- map_int_find<V>(m, key)
    if at < 0 {
        panic("map_int_get: missing key\n")
    }
    => clone(m.values[at as u64])
}

/// Return the stored value or `fallback` after a single scan.
open flow map_int_get_or<V: Clone>
    <- m: IntMap<V>
    <- key: u64
    <- fallback: V
    => V
{
    at <- map_int_find<V>(m, key)
    if at < 0 {
        => clone(fallback)
    }
    => clone(m.values[at as u64])
}

/// Return presence and a value in one scan. Both outputs are always written:
/// on a miss, `value` receives `fallback` and `found` is `false`.
open flow map_int_lookup<V: Clone>
    <- m: IntMap<V>
    <- key: u64
    <- fallback: V
    -> found: bool
    -> value: V
{
    at <- map_int_find<V>(m, key)
    if at < 0 {
        found = false
        value = clone(fallback)
        =>
    }
    found = true
    value = clone(m.values[at as u64])
}

flow map_int_grow<V: Clone>
    <-> m: IntMap<V>
{
    new_cap <- m.cap * 2
    mut keys: [u64]
    alloc(-> keys, u64, new_cap)
    mut values: [V]
    alloc(-> values, V, new_cap)
    for i in 0..m.len {
        keys[i] = m.keys[i]
        values[i] = clone(m.values[i])
    }
    m.keys = give(keys)
    m.values = give(values)
    m.cap = new_cap
}

open flow map_int_set<V: Clone>
    <-> m: IntMap<V>
    <- key: u64
    <- value: V
{
    at <- map_int_find<V>(m, key)
    if at >= 0 {
        m.values[at as u64] = clone(value)
        =>
    }
    if m.len == m.cap {
        map_int_grow<V>(<-> m)
    }
    m.keys[m.len] = key
    m.values[m.len] = clone(value)
    m.len += 1
}

open flow map_int_remove<V: Clone>
    <-> m: IntMap<V>
    <- key: u64
    => bool
{
    at <- map_int_find<V>(m, key)
    if at < 0 {
        => false
    }
    index <- at as u64
    mut next: u64 <- index + 1
    while next < m.len {
        m.keys[next - 1] = m.keys[next]
        m.values[next - 1] = clone(m.values[next])
        next += 1
    }
    m.len -= 1
    => true
}

open flow map_int_clear<V>
    <-> m: IntMap<V>
{
    m.len = 0
}

// ---------------------------------------------------------------------------
// StrMap<V>
// ---------------------------------------------------------------------------
open shape StrMap<V> {
    keys: [u8]
    starts: [u64]
    lengths: [u64]
    values: [V]
    len: u64
    cap: u64
    key_bytes: u64
    key_cap: u64
}

open flow map_str_new<V>
    -> m: StrMap<V>
{
    alloc(-> m.keys, u8, MAP_INITIAL_KEY_BYTES)
    alloc(-> m.starts, u64, MAP_INITIAL_CAP)
    alloc(-> m.lengths, u64, MAP_INITIAL_CAP)
    alloc(-> m.values, V, MAP_INITIAL_CAP)
    m.len = 0
    m.cap = MAP_INITIAL_CAP
    m.key_bytes = 0
    m.key_cap = MAP_INITIAL_KEY_BYTES
}

open flow map_str_len<V>
    <- m: StrMap<V>
    => u64
{
    => m.len
}

open flow map_str_capacity<V>
    <- m: StrMap<V>
    => u64
{
    => m.cap
}

flow map_str_find<V>
    <- m: StrMap<V>
    <- key: [u8]
    => i64
{
    for i in 0..m.len {
        size <- m.lengths[i]
        if size == key.len {
            offset <- m.starts[i]
            mut same: bool <- true
            for j in 0..size {
                if m.keys[offset + j] != key[j] {
                    same = false
                    break
                }
            }
            if same {
                => i as i64
            }
        }
    }
    => -1
}

open flow map_str_contains<V>
    <- m: StrMap<V>
    <- key: [u8]
    => bool
{
    => map_str_find<V>(m, key) >= 0
}

open flow map_str_get<V: Clone>
    <- m: StrMap<V>
    <- key: [u8]
    => V
{
    at <- map_str_find<V>(m, key)
    if at < 0 {
        panic("map_str_get: missing key\n")
    }
    => clone(m.values[at as u64])
}

/// Return the stored value or `fallback` after a single scan.
open flow map_str_get_or<V: Clone>
    <- m: StrMap<V>
    <- key: [u8]
    <- fallback: V
    => V
{
    at <- map_str_find<V>(m, key)
    if at < 0 {
        => clone(fallback)
    }
    => clone(m.values[at as u64])
}

/// Return presence and a value in one scan. Both outputs are always written:
/// on a miss, `value` receives `fallback` and `found` is `false`.
open flow map_str_lookup<V: Clone>
    <- m: StrMap<V>
    <- key: [u8]
    <- fallback: V
    -> found: bool
    -> value: V
{
    at <- map_str_find<V>(m, key)
    if at < 0 {
        found = false
        value = clone(fallback)
        =>
    }
    found = true
    value = clone(m.values[at as u64])
}

flow map_str_grow<V: Clone>
    <-> m: StrMap<V>
{
    new_cap <- m.cap * 2
    mut starts: [u64]
    alloc(-> starts, u64, new_cap)
    mut lengths: [u64]
    alloc(-> lengths, u64, new_cap)
    mut values: [V]
    alloc(-> values, V, new_cap)
    for i in 0..m.len {
        starts[i] = m.starts[i]
        lengths[i] = m.lengths[i]
        values[i] = clone(m.values[i])
    }
    m.starts = give(starts)
    m.lengths = give(lengths)
    m.values = give(values)
    m.cap = new_cap
}

flow map_str_reserve_key<V>
    <-> m: StrMap<V>
    <- extra: u64
{
    needed <- m.key_bytes + extra
    mut new_cap: u64 <- m.key_cap
    while new_cap < needed {
        new_cap *= 2
    }
    mut keys: [u8]
    alloc(-> keys, u8, new_cap)
    for i in 0..m.key_bytes {
        keys[i] = m.keys[i]
    }
    m.keys = give(keys)
    m.key_cap = new_cap
}

open flow map_str_set<V: Clone>
    <-> m: StrMap<V>
    <- key: [u8]
    <- value: V
{
    at <- map_str_find<V>(m, key)
    if at >= 0 {
        m.values[at as u64] = clone(value)
        =>
    }
    if m.len == m.cap {
        map_str_grow<V>(<-> m)
    }
    if m.key_bytes + key.len > m.key_cap {
        map_str_reserve_key<V>(<-> m, key.len)
    }
    offset <- m.key_bytes
    for i in 0..key.len {
        m.keys[offset + i] = key[i]
    }
    m.starts[m.len] = offset
    m.lengths[m.len] = key.len
    m.values[m.len] = clone(value)
    m.len += 1
    m.key_bytes += key.len
}

open flow map_str_remove<V: Clone>
    <-> m: StrMap<V>
    <- key: [u8]
    => bool
{
    at <- map_str_find<V>(m, key)
    if at < 0 {
        => false
    }
    index <- at as u64
    mut next: u64 <- index + 1
    while next < m.len {
        m.starts[next - 1] = m.starts[next]
        m.lengths[next - 1] = m.lengths[next]
        m.values[next - 1] = clone(m.values[next])
        next += 1
    }
    m.len -= 1
    => true
}

open flow map_str_clear<V>
    <-> m: StrMap<V>
{
    m.len = 0
    m.key_bytes = 0
}
