//! Operating-system package: environment, clock, files and paths.
//!
//! ```loi
//! import "lib/os.loi"            // broad package import
//! import "lib/os/time.loi"       // fine-grained import
//!
//! now <- os::os_unix_time()
//! ```
//!
//! The C shims stay at this boundary: `os_shim.c` for env/time/file.
//! Process launching and stdio are separate facades over `lib/os/process.loi`
//! and `lib/os/stdio.loi` so importing `os` alone does not link extra shims.
//! `os` depends on `core` and `runtime` by convention, never on `net`.

open import "os/env.loi"
open import "os/time.loi"
open import "os/file.loi"
open import "os/path.loi"
