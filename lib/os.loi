//! Small process/environment library backed by a C shim.
//!
//! Import it explicitly and compile `lib/os_shim.c` with the program:
//!
//! ```loi
//! import "lib/os.loi"
//! ```
//!
//! ```sh
//! loi build main.loi -o main --c-source lib/os_shim.c
//! ```
//!
//! Like the vendored bindings, the `extern flow` declarations below are a thin
//! binding: the shim owns the POSIX details and keeps foreign pointers out of
//! ordinary Loi values. The helpers are POSIX-only.

extern flow loi_os_pid
    => i32

extern flow loi_os_unix_time
    => i64

extern flow loi_os_sleep_ms
    <- millis: i32

extern flow loi_os_has_env
    <- name: cstr
    => bool

extern flow loi_os_env_i32
    <- name: cstr
    <- fallback: i32
    => i32

extern flow loi_os_errno
    => i32

extern flow loi_os_exit
    <- code: i32

open flow os_pid
    => i32
{
    => loi_os_pid()
}

/// Seconds since the Unix epoch, or -1 when the platform cannot provide it.
open flow os_unix_time
    => i64
{
    => loi_os_unix_time()
}

/// Sleep for whole milliseconds. Returns false for a negative duration.
open flow os_sleep
    <- millis: i32
    => bool
{
    if millis < 0 {
        => false
    }
    loi_os_sleep_ms(millis)
    => true
}

open flow os_has_env
    <- name: cstr
    => bool
{
    => loi_os_has_env(name)
}

/// Read an integer environment variable, using `fallback` when it is absent,
/// empty or malformed.
open flow os_env_i32
    <- name: cstr
    <- fallback: i32
    => i32
{
    => loi_os_env_i32(name, fallback)
}

open flow os_errno
    => i32
{
    => loi_os_errno()
}

/// Terminate the process immediately; no Loi cleanup runs.
open flow os_exit
    <- code: i32
{
    loi_os_exit(code)
}

// ---------------------------------------------------------------------------
// Linear file handles
// ---------------------------------------------------------------------------

//! A `File` is a linear non-memory resource: put it in a `guard` block and the
//! matching `file_release` flow closes the descriptor on every exit path. The
//! handle is an integer descriptor; the shim owns the POSIX file details.

extern flow loi_io_open
    <- path: cstr
    <- write: i32
    => i32

extern flow loi_io_close
    <- fd: i32

extern flow loi_io_read
    <- fd: i32
    <-> data: [u8]
    => i64

extern flow loi_io_write
    <- fd: i32
    <- data: [u8]
    => i64

/// An owned file descriptor. `fd` is -1 after a failed open or a release.
open shape File [
    fd: i32
]

/// Close the descriptor. `guard` calls this automatically; do not call it
/// directly on a guarded handle.
open flow file_release
    <-> file: File
{
    if file.fd >= 0 {
        loi_io_close(file.fd)
        file.fd = -1
    }
}

/// Open a file for reading. Returns a handle with `fd` -1 on failure.
open flow file_open_read
    <- path: cstr
    => File
{
    => File[ fd: loi_io_open(path, 0) ]
}

/// Open (or create and truncate) a file for writing.
open flow file_open_write
    <- path: cstr
    => File
{
    => File[ fd: loi_io_open(path, 1) ]
}

/// Read into the caller's buffer. Returns the byte count, or -1 on error or
/// after a failed open. The buffer must be owned by an active `protect` region.
open flow file_read
    <- file: File
    <-> data: [u8]
    => i64
{
    if file.fd < 0 {
        => -1
    }
    => loi_io_read(file.fd, <-> data)
}

/// Write every byte of `data`; returns the byte count, or -1 on error.
open flow file_write
    <- file: File
    <- data: [u8]
    => i64
{
    if file.fd < 0 {
        => -1
    }
    => loi_io_write(file.fd, data)
}
