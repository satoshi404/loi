//! LSP diagnostics formatter written in pure Loi.
//!
//! The compiler emits structured diagnostics with
//! `loi check FILE --error-format json`. A server using this module can spawn
//! that check itself through `lib/process.loi`, then turn the captured JSON into
//! an LSP `textDocument/publishDiagnostics` notification. This module only
//! formats the notification; it does not run the compiler.
//!
//! Compiler spans are 1-based; LSP `line` and `character` are 0-based.
//! Severity strings map as `error` -> 1, `warning` -> 2, `note` -> 3.
//!
//! `lsp_write_document` stores the text supplied by `didOpen` / `didChange`
//! in a shadow file before the server checks it, and `lsp_remove_document`
//! deletes that shadow afterwards. The caller chooses the path, so a server
//! can keep the editor's original file untouched. Link `lib/lsp_shim.c` when
//! using those flows.

import "json.loi"
import "jsonrpc.loi"
import "std.loi"
import "string.loi"
import "vec.loi"

extern flow loi_lsp_write_document
    <- path: [u8]
    <- text: [u8]
    => i64

extern flow loi_lsp_remove_document
    <- path: [u8]
    => i64

extern flow loi_lsp_document_len
    <- path: [u8]
    => i64

extern flow loi_lsp_read_document
    <- path: [u8]
    <-> data: [u8]
    => i64

/// Write the current text of a document to `path`, so the compiler checks the
/// client's buffer instead of whatever happens to be on disk. Returns false
/// when the file cannot be created or written.
open flow lsp_write_document
    <- path: [u8]
    <- text: [u8]
    => bool
{
    => loi_lsp_write_document(path, text) >= 0
}

/// Delete a shadow written by `lsp_write_document`. Returns false when the
/// file does not exist or cannot be removed.
open flow lsp_remove_document
    <- path: [u8]
    => bool
{
    => loi_lsp_remove_document(path) == 0
}

/// Read a document cache written by `lsp_write_document`. The caller's active
/// `protect` region owns the returned buffer; a missing file returns `""`.
open flow lsp_read_document
    <- path: [u8]
    => [u8]
{
    length <- loi_lsp_document_len(path)
    if length <= 0 {
        => ""
    }
    mut data: [u8]
    alloc(-> data, u8, length as u64)
    got <- loi_lsp_read_document(path, <-> data)
    if got != length {
        => ""
    }
    => data
}

sealed flow lsp_zero_based
    <- value: i64
    => u64
{
    if value > 0 {
        => (value - 1) as u64
    }
    => 0
}

sealed flow lsp_severity
    <- doc: JsonDoc
    <- item: i64
    => u64
{
    node <- json_object_get(<- doc, item, "severity")
    if node < 0 or json_kind(<- doc, node) != JsonKind.String {
        => 1
    }
    text <- json_string(<- doc, node)
    if str_eq(text, "warning") {
        => 2
    }
    if str_eq(text, "note") {
        => 3
    }
    => 1
}

sealed flow lsp_number
    <- doc: JsonDoc
    <- node: i64
    => i64
{
    if node < 0 or json_kind(<- doc, node) != JsonKind.Number {
        => 0
    }
    => json_number_i64(<- doc, node)
}

/// The compiler's `help` field carries concrete suggestions such as a close
/// variable name. LSP diagnostics have no help field, so append it to the
/// message clients actually display.
sealed flow lsp_message
    <- doc: JsonDoc
    <- item: i64
    => [u8]
{
    message <- json_string(<- doc, json_object_get(<- doc, item, "message"))
    help <- json_object_get(<- doc, item, "help")
    if help < 0 or json_kind(<- doc, help) != JsonKind.String {
        => message
    }
    suggestion <- json_string(<- doc, help)
    => str_concat(str_concat(message, ": "), suggestion)
}

/// Publish one compiler JSON document as an LSP notification. Empty or
/// malformed input publishes an empty diagnostics array, which clears any
/// previous markers for the URI. Requires the caller's `protect` region.
open flow lsp_publish_diagnostics
    <- uri: [u8]
    <- diagnostics_json: [u8]
{
    mut out: JsonDoc
    json_new(-> out)
    params <- json_new_object(<-> out)
    uri_node <- json_new_string(<-> out, uri)
    json_object_set(<-> out, params, "uri", uri_node)
    array <- json_new_array(<-> out)
    json_object_set(<-> out, params, "diagnostics", array)

    mut doc: JsonDoc
    ok <- json_parse(diagnostics_json, -> doc)
    if ok {
        root <- json_root(<- doc)
        count <- json_array_len(<- doc, root)
        for i in 0..count {
            item <- json_array_get(<- doc, root, i)

            range <- json_new_object(<-> out)
            start <- json_new_object(<-> out)
            end <- json_new_object(<-> out)
            start_line <- json_new_u64(<-> out, lsp_zero_based(lsp_number(<- doc, json_object_get(<- doc, item, "line"))))
            start_character <- json_new_u64(<-> out, lsp_zero_based(lsp_number(<- doc, json_object_get(<- doc, item, "column"))))
            end_line <- json_new_u64(<-> out, lsp_zero_based(lsp_number(<- doc, json_object_get(<- doc, item, "end_line"))))
            end_character <- json_new_u64(<-> out, lsp_zero_based(lsp_number(<- doc, json_object_get(<- doc, item, "end_column"))))
            json_object_set(<-> out, start, "line", start_line)
            json_object_set(<-> out, start, "character", start_character)
            json_object_set(<-> out, end, "line", end_line)
            json_object_set(<-> out, end, "character", end_character)
            json_object_set(<-> out, range, "start", start)
            json_object_set(<-> out, range, "end", end)

            entry <- json_new_object(<-> out)
            json_object_set(<-> out, entry, "range", range)
            severity <- json_new_u64(<-> out, lsp_severity(<- doc, item))
            json_object_set(<-> out, entry, "severity", severity)

            message <- lsp_message(<- doc, item)
            message_value <- json_new_string(<-> out, message)
            json_object_set(<-> out, entry, "message", message_value)
            json_array_push(<-> out, array, entry)
        }
    }
    json_set_root(<-> out, params)
    jsonrpc_send_notification(
        "textDocument/publishDiagnostics",
        json_stringify(<- out)
    )
}

/// Convert `loi complete` JSON into a `textDocument/completion` response. The
/// compiler owns the candidate list; this flow only translates the wire shape
/// and fills the `isIncomplete` flag. Requires the caller's `protect` region.
open flow lsp_send_completion
    <- id: i64
    <- completion_json: [u8]
{
    mut out: JsonDoc
    json_new(-> out)
    items <- json_new_array(<-> out)
    result <- json_new_object(<-> out)
    incomplete <- json_new_bool(<-> out, false)
    json_object_set(<-> out, result, "isIncomplete", incomplete)
    json_object_set(<-> out, result, "items", items)

    mut doc: JsonDoc
    if json_parse(completion_json, -> doc) {
        root <- json_root(<- doc)
        count <- json_array_len(<- doc, root)
        for i in 0..count {
            compiler_item <- json_array_get(<- doc, root, i)
            item <- json_new_object(<-> out)

            label <- json_string(<- doc, json_object_get(<- doc, compiler_item, "label"))
            label_value <- json_new_string(<-> out, label)
            json_object_set(<-> out, item, "label", label_value)

            kind <- json_number_i64(<- doc, json_object_get(<- doc, compiler_item, "kind"))
            kind_value <- json_new_u64(<-> out, kind as u64)
            json_object_set(<-> out, item, "kind", kind_value)

            detail <- json_string(<- doc, json_object_get(<- doc, compiler_item, "detail"))
            detail_value <- json_new_string(<-> out, detail)
            json_object_set(<-> out, item, "detail", detail_value)

            json_array_push(<-> out, items, item)
        }
    }
    json_set_root(<-> out, result)
    jsonrpc_send_result(id, json_stringify(<- out))
}
