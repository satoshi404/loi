//! Generic slice helpers written in Loi.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/slice.loi"
//! ```
//!
//! `slice_clone` and `slice_copy` allocate from the caller's `protect` arena.
//! Values are cloned, so `T` must be cloneable by value. `slice_find` is
//! numeric-only because Loi has no trait constraints; see
//! `development/FRICTION.md`.

// ---------------------------------------------------------------------------
// Runtime error formatting
// ---------------------------------------------------------------------------

sealed flow slice_decimal_len
    <- value: u64
    => u64
{
    mut rest: u64 <- value
    mut digits: u64 <- 1
    while rest >= 10 {
        rest /= 10
        digits += 1
    }
    => digits
}

sealed flow slice_write_bytes
    <- text: [u8]
    <-> out: [u8]
    <- pos: u64
    => u64
{
    mut at: u64 <- pos
    for i in 0..text.len {
        out[at] = text[i]
        at += 1
    }
    => at
}

sealed flow slice_write_u64
    <- value: u64
    <-> out: [u8]
    <- pos: u64
    => u64
{
    digits <- slice_decimal_len(value)
    mut divisor: u64 <- 1
    mut made: u64 <- 1
    while made < digits {
        divisor *= 10
        made += 1
    }
    mut at: u64 <- pos
    while divisor > 0 {
        digit <- (value / divisor) % 10
        out[at] = digit as u8 + 48
        at += 1
        divisor /= 10
    }
    => at
}

sealed flow slice_fail_range
    <- name: [u8]
    <- index: u64
    <- len: u64
{
    mut total: u64 <- name.len
    total += ": index ".len
    total += slice_decimal_len(index)
    total += " out of range (len ".len
    total += slice_decimal_len(len)
    total += ")\n".len
    mut msg: [u8]
    alloc(-> msg, u8, total)
    mut at: u64 <- 0
    at = slice_write_bytes(name, <-> msg, at)
    at = slice_write_bytes(": index ", <-> msg, at)
    at = slice_write_u64(index, <-> msg, at)
    at = slice_write_bytes(" out of range (len ", <-> msg, at)
    at = slice_write_u64(len, <-> msg, at)
    at = slice_write_bytes(")\n", <-> msg, at)
    panic(msg)
}

sealed flow slice_fail_empty
    <- name: [u8]
    <- len: u64
{
    mut total: u64 <- name.len
    total += ": slice is empty (len ".len
    total += slice_decimal_len(len)
    total += ")\n".len
    mut msg: [u8]
    alloc(-> msg, u8, total)
    mut at: u64 <- 0
    at = slice_write_bytes(name, <-> msg, at)
    at = slice_write_bytes(": slice is empty (len ", <-> msg, at)
    at = slice_write_u64(len, <-> msg, at)
    at = slice_write_bytes(")\n", <-> msg, at)
    panic(msg)
}

// ---------------------------------------------------------------------------
// Inspection
// ---------------------------------------------------------------------------

open flow slice_len<T>
    <- values: [T]
    => u64
{
    => values.len
}

open flow slice_is_empty<T>
    <- values: [T]
    => bool
{
    => values.len == 0
}

sealed flow slice_get<T>
    <- values: [T]
    <- index: u64
    => T
{
    if index >= values.len {
        slice_fail_range("slice_get", index, values.len)
    }
    => clone(values[index])
}

sealed flow slice_first<T>
    <- values: [T]
    => T
{
    if values.len == 0 {
        slice_fail_empty("slice_first", values.len)
    }
    => clone(values[0])
}

sealed flow slice_last<T>
    <- values: [T]
    => T
{
    if values.len == 0 {
        slice_fail_empty("slice_last", values.len)
    }
    => clone(values[values.len - 1])
}

open flow slice_find<T>
    <- values: [T]
    <- needle: T
    => i64
{
    for i in 0..values.len {
        if values[i] == needle {
            => i as i64
        }
    }
    => -1
}

open flow slice_equals_u8
    <- left: [u8]
    <- right: [u8]
    => bool
{
    => left == right
}

// ---------------------------------------------------------------------------
// Copying and mutation
// ---------------------------------------------------------------------------

sealed flow slice_clone<T>
    <- values: [T]
    => [T]
{
    mut copy: [T]
    alloc(-> copy, T, values.len)
    for i in 0..values.len {
        copy[i] = clone(values[i])
    }
    => give(copy)
}

sealed flow slice_copy<T>
    <- values: [T]
    -> out: [T]
{
    alloc(-> out, T, values.len)
    for i in 0..values.len {
        out[i] = clone(values[i])
    }
}

sealed flow slice_swap<T>
    <-> values: [T]
    <- i: u64
    <- j: u64
{
    mut saved: T <- clone(values[i])
    values[i] = clone(values[j])
    values[j] = clone(saved)
}

open flow slice_reverse<T>
    <-> values: [T]
{
    half <- values.len / 2
    for i in 0..half {
        j <- values.len - 1 - i
        slice_swap<T>(<-> values, i, j)
    }
}
