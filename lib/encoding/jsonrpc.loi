//! Minimal JSON-RPC 2.0 transport for an LSP server written in Loi.
//!
//! Import it explicitly and link the stdio shim:
//!
//! ```loi
//! import "lib/jsonrpc.loi"
//! ```
//!
//! ```sh
//! loi build main.loi -o main --c-source lib/stdio_shim.c
//! ```
//!
//! `jsonrpc_read_frame` reads one `Content-Length` frame from stdin and
//! `jsonrpc_parse_request` validates a JSON-RPC 2.0 request. The reply flows
//! build a compact response and write it back as a framed, flushed message.
//! Every flow that allocates requires the caller's `protect` region. As in
//! `lib/stdio.loi`, a zero-length frame or EOF ends the exchange.
import "../std/ctype.loi"

import "json.loi"

import "../std/convert.loi"

import "../std/str.loi"

import "../os/stdio.loi"

import "../std/vec.loi"

/// A validated JSON-RPC 2.0 request. `method` is a borrowed view into the
/// decoded-string arena of `doc`; both stay live until `protect` ends.
open shape JsonRpcRequest {
    doc: JsonDoc
    id: i64
    method: [u8]
    has_id: bool
}

flow jsonrpc_starts_with
    <- text: [u8]
    <- prefix: [u8]
    => bool
{
    if text.len < prefix.len {
        => false
    }
    for i in 0..prefix.len {
        if text[i] != prefix[i] {
            => false
        }
    }
    => true
}

flow jsonrpc_header_length
    <- line: [u8]
    -> length: u64
    => bool
{
    length = 0
    prefix <- "Content-Length: "
    if not jsonrpc_starts_with(line, prefix) {
        => false
    }
    mut index: u64 <- prefix.len
    while index < line.len {
        byte <- line[index]
        if byte < 48 or byte > 57 {
            break
        }
        length = length * 10 + (byte - 48) as u64
        index += 1
    }
    => index > prefix.len
}

/// Read exactly one framed body from stdin. Returns false at EOF, on a
/// malformed header, or on a zero-length frame used as a shutdown sentinel.
/// The body lives in the caller's `protect` region.
open flow jsonrpc_read_frame
    -> body: [u8]
    => bool
{
    mut length: u64 <- 0
    mut found: bool <- false
    while true {
        line <- read_line()
        if line.len == 0 {
            break
        }
        mut candidate: u64
        if jsonrpc_header_length(line, -> candidate) {
            length = candidate
            found = true
        }
    }
    if not found or length == 0 {
        => false
    }
    alloc(-> body, u8, length)
    got <- stdio_read_exact(<-> body)
    if got != length as i64 {
        => false
    }
    => true
}

/// Parse `body` and validate the JSON-RPC envelope. Returns false for
/// malformed JSON, a non-object root, a wrong version, or a missing method.
/// `id` is optional: notifications leave `has_id` false and `id` zero.
open flow jsonrpc_parse_request
    <- body: [u8]
    -> request: JsonRpcRequest
    => bool
{
    ok <- json_parse(body, -> request.doc)
    if not ok {
        => false
    }
    root <- json_root(request.doc)
    if json_kind(request.doc, root) != JsonKind.Object {
        => false
    }
    version <- json_object_get(request.doc, root, "jsonrpc")
    if version < 0 or json_kind(request.doc, version) != JsonKind.String {
        => false
    }
    if not str_eq(json_string(request.doc, version), "2.0") {
        => false
    }
    method <- json_object_get(request.doc, root, "method")
    if method < 0 or json_kind(request.doc, method) != JsonKind.String {
        => false
    }
    request.method = json_string(request.doc, method)
    request.has_id = false
    request.id = 0
    id <- json_object_get(request.doc, root, "id")
    if id >= 0 {
        if json_kind(request.doc, id) != JsonKind.Number {
            => false
        }
        request.id = json_number_i64(request.doc, id)
        request.has_id = true
    }
    => true
}

flow jsonrpc_append_bytes
    <-> out: Vec<u8>
    <- bytes: [u8]
{
    for i in 0..bytes.len {
        vec_push<u8>(<-> out, bytes[i])
    }
}

flow jsonrpc_send_bytes
    <- body: [u8]
{
    printf("Content-Length: %llu\r\n\r\n", body.len)
    written <- stdio_write_all(body)
    if written != body.len as i64 {
        panic("jsonrpc: short write\n")
    }
    stdio_flush()
}

flow jsonrpc_begin_response
    -> out: Vec<u8>
{
    vec_new<u8>(-> out)
    jsonrpc_append_bytes(<-> out, "{\"jsonrpc\":\"2.0\",\"id\":")
}

/// Reply with a successful result. `result` is raw JSON (for example
/// `"null"` or `"{\"capabilities\":{}}"`), copied verbatim into the response.
open flow jsonrpc_send_result
    <- id: i64
    <- result: [u8]
{
    mut out: Vec<u8>
    jsonrpc_begin_response(-> out)
    jsonrpc_append_bytes(<-> out, i64_to_bytes(id))
    jsonrpc_append_bytes(<-> out, ",\"result\":")
    jsonrpc_append_bytes(<-> out, result)
    jsonrpc_append_bytes(<-> out, "}")
    jsonrpc_send_bytes(vec_view<u8>(out, 0, out.len))
}

/// Send a framed server-to-client notification. There is no `id`, so the
/// client sends no reply. `method` must not need escaping and `params` must be
/// a complete JSON value (use `"{}"` when there are no parameters).
open flow jsonrpc_send_notification
    <- method: [u8]
    <- params: [u8]
{
    mut out: Vec<u8>
    vec_new<u8>(-> out)
    jsonrpc_append_bytes(<-> out, "{\"jsonrpc\":\"2.0\",\"method\":\"")
    jsonrpc_append_bytes(<-> out, method)
    jsonrpc_append_bytes(<-> out, "\",\"params\":")
    jsonrpc_append_bytes(<-> out, params)
    jsonrpc_append_bytes(<-> out, "}")
    jsonrpc_send_bytes(vec_view<u8>(out, 0, out.len))
}

/// Reply with a JSON-RPC error object. `message` must not need escaping.
open flow jsonrpc_send_error
    <- id: i64
    <- code: i64
    <- message: [u8]
{
    mut out: Vec<u8>
    jsonrpc_begin_response(-> out)
    jsonrpc_append_bytes(<-> out, i64_to_bytes(id))
    jsonrpc_append_bytes(<-> out, ",\"error\":{\"code\":")
    jsonrpc_append_bytes(<-> out, i64_to_bytes(code))
    jsonrpc_append_bytes(<-> out, ",\"message\":\"")
    jsonrpc_append_bytes(<-> out, message)
    jsonrpc_append_bytes(<-> out, "\"}}")
    jsonrpc_send_bytes(vec_view<u8>(out, 0, out.len))
}
