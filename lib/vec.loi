//! Arena-backed dynamic vectors written in Loi.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/vec.loi"
//! ```
//!
//! Every flow that allocates must be called from inside a `protect` block;
//! the storage lives until that block ends. Flows that copy elements declare
//! `T: Clone`; every Loi type satisfies it because `clone` is recursive, but
//! cloning a value containing slices still allocates. `vec_find<T>` declares
//! `T: Eq`, so equality search works for numbers, bool, marks and `[u8]`.
//! Ordering flows are still numeric-only because Loi has no `Ord` constraint;
//! see `development/FRICTION.md`. The arena keeps older growth
//! blocks until the enclosing `protect` ends, so call `vec_reserve<T>` when the
//! final size is known: pre-reserving once avoids the peak memory of repeated
//! geometric growth.

// ---------------------------------------------------------------------------
// Runtime error formatting
// ---------------------------------------------------------------------------

sealed flow vec_decimal_len
    <- value: u64
    => u64
{
    mut rest: u64 <- value
    mut digits: u64 <- 1
    while rest >= 10 {
        rest /= 10
        digits += 1
    }
    => digits
}

sealed flow vec_write_bytes
    <- text: [u8]
    <-> out: [u8]
    <- pos: u64
    => u64
{
    mut at: u64 <- pos
    for i in 0..text.len {
        out[at] = text[i]
        at += 1
    }
    => at
}

sealed flow vec_write_u64
    <- value: u64
    <-> out: [u8]
    <- pos: u64
    => u64
{
    digits <- vec_decimal_len(value)
    mut divisor: u64 <- 1
    mut made: u64 <- 1
    while made < digits {
        divisor *= 10
        made += 1
    }
    mut at: u64 <- pos
    while divisor > 0 {
        digit <- (value / divisor) % 10
        out[at] = digit as u8 + 48
        at += 1
        divisor /= 10
    }
    => at
}

sealed flow vec_fail_range
    <- name: [u8]
    <- index: u64
    <- len: u64
{
    mut total: u64 <- name.len
    total += ": index ".len
    total += vec_decimal_len(index)
    total += " out of range (len ".len
    total += vec_decimal_len(len)
    total += ")\n".len
    mut msg: [u8]
    alloc(-> msg, u8, total)
    mut at: u64 <- 0
    at = vec_write_bytes(name, <-> msg, at)
    at = vec_write_bytes(": index ", <-> msg, at)
    at = vec_write_u64(index, <-> msg, at)
    at = vec_write_bytes(" out of range (len ", <-> msg, at)
    at = vec_write_u64(len, <-> msg, at)
    at = vec_write_bytes(")\n", <-> msg, at)
    panic(msg)
}

sealed flow vec_fail_empty
    <- name: [u8]
    <- len: u64
{
    mut total: u64 <- name.len
    total += ": vector is empty (len ".len
    total += vec_decimal_len(len)
    total += ")\n".len
    mut msg: [u8]
    alloc(-> msg, u8, total)
    mut at: u64 <- 0
    at = vec_write_bytes(name, <-> msg, at)
    at = vec_write_bytes(": vector is empty (len ", <-> msg, at)
    at = vec_write_u64(len, <-> msg, at)
    at = vec_write_bytes(")\n", <-> msg, at)
    panic(msg)
}

// ---------------------------------------------------------------------------
// Shape and capacity
// ---------------------------------------------------------------------------

open shape Vec<T> [
    data: [T]
    len: u64
    cap: u64
]

open flow vec_new<T>
    -> v: Vec<T>
{
    // An empty slice needs no backing storage, so constructing an empty
    // vector does not require a surrounding `protect` region. The first
    // push reserves at least one slot.
    v.data = [T:]
    v.len = 0
    v.cap = 0
}

open flow vec_view<T>
    <- v: Vec<T>
    <- start: u64
    <- end: u64
    => [T]
{
    // Zero-copy borrowed window over the vector's live prefix. The vector
    // cannot be grown, cleared or moved while the returned view is live.
    => view(v.data, start, end)
}

open flow vec_len<T>
    <- v: Vec<T>
    => u64
{
    => v.len
}

open flow vec_capacity<T>
    <- v: Vec<T>
    => u64
{
    => v.cap
}

open flow vec_is_empty<T>
    <- v: Vec<T>
    => bool
{
    => v.len == 0
}

open flow vec_reserve<T: Clone>
    <-> v: Vec<T>
    <- capacity: u64
{
    if capacity <= v.cap {
        => 
    }
    mut new_cap: u64 <- v.cap * 2
    if new_cap < capacity {
        new_cap = capacity
    }
    if new_cap == 0 {
        new_cap = 1
    }
    mut grown: [T]
    alloc(-> grown, T, new_cap)
    for i in 0..v.len {
        grown[i] = clone(v.data[i])
    }
    v.data = give(grown)
    v.cap = new_cap
}

open flow vec_clear<T>
    <-> v: Vec<T>
{
    v.len = 0
}

// ---------------------------------------------------------------------------
// Element access
// ---------------------------------------------------------------------------

open flow vec_get<T: Clone>
    <- v: Vec<T>
    <- index: u64
    => T
{
    if index >= v.len {
        vec_fail_range("vec_get", index, v.len)
    }
    => clone(v.data[index])
}

open flow vec_set<T: Clone>
    <-> v: Vec<T>
    <- index: u64
    <- value: T
{
    if index >= v.len {
        vec_fail_range("vec_set", index, v.len)
        => 
    }
    v.data[index] = clone(value)
}

open flow vec_push<T: Clone>
    <-> v: Vec<T>
    <- value: T
{
    if v.len == v.cap {
        mut needed: u64 <- v.cap * 2
        if needed == 0 {
            needed = 1
        }
        vec_reserve<T>(<-> v, needed)
    }
    v.data[v.len] = clone(value)
    v.len += 1
}

open flow vec_pop<T: Clone>
    <-> v: Vec<T>
    => T
{
    if v.len == 0 {
        vec_fail_empty("vec_pop", v.len)
    }
    v.len -= 1
    => clone(v.data[v.len])
}

open flow vec_find<T: Eq>
    <- v: Vec<T>
    <- value: T
    => i64
{
    for i in 0..v.len {
        if v.data[i] == value {
            => i as i64
        }
    }
    => -1
}

open flow vec_from_slice<T: Clone>
    <- values: [T]
    -> v: Vec<T>
{
    alloc(-> v.data, T, values.len)
    for i in 0..values.len {
        v.data[i] = clone(values[i])
    }
    v.len = values.len
    v.cap = values.len
}

open flow vec_as_slice<T: Clone>
    <- v: Vec<T>
    => [T]
{
    mut copy: [T]
    alloc(-> copy, T, v.len)
    for i in 0..v.len {
        copy[i] = clone(v.data[i])
    }
    => give(copy)
}

// ---------------------------------------------------------------------------
// Mutation and ordering (ordering still requires numeric T)
// ---------------------------------------------------------------------------

sealed flow vec_swap<T: Clone>
    <-> v: Vec<T>
    <- i: u64
    <- j: u64
{
    mut saved: T <- clone(v.data[i])
    v.data[i] = clone(v.data[j])
    v.data[j] = clone(saved)
}

open flow vec_reverse<T: Clone>
    <-> v: Vec<T>
{
    half <- v.len / 2
    for i in 0..half {
        j <- v.len - 1 - i
        vec_swap<T>(<-> v, i, j)
    }
}

sealed flow vec_sift_down<T: Clone>
    <-> v: Vec<T>
    <- start: u64
    <- end: u64
{
    mut root: u64 <- start
    mut child: u64 <- root * 2 + 1
    while child < end {
        mut largest: u64 <- root
        if clone(v.data[child]) > clone(v.data[largest]) {
            largest = child
        }
        right <- child + 1
        if right < end and clone(v.data[right]) > clone(v.data[largest]) {
            largest = right
        }
        if largest == root {
            break
        }
        vec_swap<T>(<-> v, root, largest)
        root = largest
        child = root * 2 + 1
    }
}

open flow vec_sort<T: Clone>
    <-> v: Vec<T>
{
    if v.len >= 2 {
        count <- v.len
        mut start: u64 <- count / 2
        while start > 0 {
            start -= 1
            vec_sift_down<T>(<-> v, start, count)
        }
        mut end: u64 <- count
        while end > 1 {
            end -= 1
            vec_swap<T>(<-> v, 0, end)
            vec_sift_down<T>(<-> v, 0, end)
        }
    }
}

open flow vec_binary_search<T: Clone>
    <- v: Vec<T>
    <- value: T
    => i64
{
    mut low: u64 <- 0
    mut high: u64 <- v.len
    while low < high {
        mid <- low + (high - low) / 2
        got <- clone(v.data[mid])
        if got < value {
            low = mid + 1
        } else if value < got {
            high = mid
        } else {
            => mid as i64
        }
    }
    => -1
}
