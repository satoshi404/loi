//! CRC-32 (IEEE 802.3) written in Loi with a compile-time nibble table.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/crc32.loi"
//! ```
//!
//! The 16 reflected table entries are computed by `comptime` flows and packed
//! two per `u64` into a static slice, so no arena allocation or `protect`
//! block is needed. `crc32_update` folds raw chunk state, `crc32_extend`
//! continues a finished CRC the way zlib's `crc32(crc, buf)` does, and
//! `crc32_bytes` is the one-shot form with the standard initial and final
//! XOR values.
// Reflected CRC-32 polynomial, initial state and final XOR.
open CRC32_POLY: u32 <- 0xedb88320

open CRC32_INIT: u32 <- 0xffffffff

open CRC32_XOROUT: u32 <- 0xffffffff

/// One nibble table entry: four reflected steps applied to `index`.
comptime flow crc32_nibble_entry
    <- index: u64
    => u32
{
    mut c: u32 <- index as u32
    mut k: u64 <- 0
    while k < 4 {
        if c & 1 != 0 {
            c = c >> 1 ^ CRC32_POLY
        } else {
            c >>= 1
        }
        k += 1
    }
    => c
}

/// Two 32-bit entries packed into one compile-time `u64`.
comptime flow crc32_word
    <- which: u64
    => u64
{
    low <- crc32_nibble_entry(which * 2) as u64
    high <- crc32_nibble_entry(which * 2 + 1) as u64
    => low | high << 32
}

open CRC32_TABLE: [u64] <- [u64: comptime crc32_word(0), comptime crc32_word(1), comptime crc32_word(2), comptime crc32_word(3), comptime crc32_word(4), comptime crc32_word(5), comptime crc32_word(6), comptime crc32_word(7)]

flow crc32_nibble
    <- index: u32
    => u32
{
    at <- index as u64
    word <- CRC32_TABLE[at / 2]
    shifted <- word >> at % 2 * 32
    => shifted as u32
}

/// Fold one chunk into a running CRC state. Pass `CRC32_INIT` for the first
/// chunk and the returned value to the next call.
open flow crc32_update
    <- state: u32
    <- data: [u8]
    => u32
{
    mut crc: u32 <- state
    for <- byte in data {
        crc ^= byte as u32
        crc = crc >> 4 ^ crc32_nibble(crc & 0xf)
        crc = crc >> 4 ^ crc32_nibble(crc & 0xf)
    }
    => crc
}

/// Continue an already finalized CRC over another chunk. This matches zlib's
/// `crc32(crc, buf)`: pass the previously returned CRC and get another final
/// CRC back, so callers do not need to keep a raw internal state.
open flow crc32_extend
    <- crc: u32
    <- data: [u8]
    => u32
{
    => crc32_update(crc ^ CRC32_XOROUT, data) ^ CRC32_XOROUT
}

open flow crc32_bytes
    <- data: [u8]
    => u32
{
    => crc32_update(CRC32_INIT, data) ^ CRC32_XOROUT
}
