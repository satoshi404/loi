//! Deterministic 64-bit FNV-1a hashing written in Loi.
//!
//! Import it explicitly:
//!
//! ```loi
//! import "lib/hash.loi"
//! ```
//!
//! Every flow is pure: it reads its inputs and returns a `u64`, so no
//! `protect` block is needed. Unsigned multiplication wraps at 64 bits, which
//! is exactly what FNV-1a requires. `hash_u64` hashes the little-endian bytes
//! of the integer; `hash_pair_u64(a, b)` is the hash of `a`'s bytes followed by
//! `b`'s bytes.
// FNV-1a 64-bit parameters.
open HASH_OFFSET: u64 <- 0xcbf29ce484222325

open HASH_PRIME: u64 <- 0x100000001b3

open flow hash_bytes_seeded
    <- data: [u8]
    <- seed: u64
    => u64
{
    mut hash: u64 <- seed
    for <- byte in data {
        hash ^= byte as u64
        hash *= HASH_PRIME
    }
    => hash
}

open flow hash_bytes
    <- data: [u8]
    => u64
{
    => hash_bytes_seeded(data, HASH_OFFSET)
}

open flow hash_str
    <- text: [u8]
    => u64
{
    => hash_bytes(text)
}

open flow hash_u64_seeded
    <- value: u64
    <- seed: u64
    => u64
{
    mut hash: u64 <- seed
    mut remaining: u64 <- value
    for i in 0..8 {
        byte <- (remaining % 256) as u8
        hash ^= byte as u64
        hash *= HASH_PRIME
        remaining /= 256
    }
    => hash
}

open flow hash_u64
    <- value: u64
    => u64
{
    => hash_u64_seeded(value, HASH_OFFSET)
}

open flow hash_pair_u64
    <- left: u64
    <- right: u64
    => u64
{
    mut hash: u64 <- hash_u64(left)
    mut remaining: u64 <- right
    for i in 0..8 {
        byte <- (remaining % 256) as u8
        hash ^= byte as u64
        hash *= HASH_PRIME
        remaining /= 256
    }
    => hash
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `hash_bytes_seeded`.
open flow bytes_seeded
<- data: [u8]
<- seed: u64
=> u64
{
    => hash_bytes_seeded(data, seed)
}

/// Short alias of `hash_bytes`.
open flow bytes
<- data: [u8]
=> u64
{
    => hash_bytes(data)
}

/// Short alias of `hash_u64_seeded`.
open flow u64_seeded
<- value: u64
<- seed: u64
=> u64
{
    => hash_u64_seeded(value, seed)
}

/// Short alias of `hash_pair_u64`.
open flow pair_u64
<- left: u64
<- right: u64
=> u64
{
    => hash_pair_u64(left, right)
}
