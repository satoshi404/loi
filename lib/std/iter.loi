//! Ownership-friendly iteration patterns over slices.
//!
//! Re-exported by `lib/std.loi`. Views and slices stay explicit: these helpers
//! borrow `<-` and never clone or give the collection behind the caller's back.

open flow iter_len<T>
    <- values: [T]
    => u64
{
    => values.len
}

open flow iter_sum_u64
    <- values: [u64]
    => u64
{
    mut total: u64 <- 0
    for i in 0..values.len {
        total += values[i]
    }
    => total
}

open flow iter_any_i64
    <- values: [i64]
    <- target: i64
    => bool
{
    for i in 0..values.len {
        if values[i] == target {
            => true
        }
    }
    => false
}

open flow iter_all_positive_i64
    <- values: [i64]
    => bool
{
    for i in 0..values.len {
        if values[i] <= 0 {
            => false
        }
    }
    => true
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `iter_sum_u64`.
open flow sum_u64
<- values: [u64]
=> u64
{
    => iter_sum_u64(values)
}

/// Short alias of `iter_any_i64`.
open flow any_i64
<- values: [i64]
<- target: i64
=> bool
{
    => iter_any_i64(values, target)
}

/// Short alias of `iter_all_positive_i64`.
open flow all_positive_i64
<- values: [i64]
=> bool
{
    => iter_all_positive_i64(values)
}
