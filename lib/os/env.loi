//! Process identity, environment access and errno. `os_pid` and `os_exit`
//! bind directly to libc (`getpid`/`exit`); the remaining flows are backed by
//! `lib/os_shim.c`.
//!
//! Import through the package root or directly:
//!
//! ```loi
//! import "lib/os.loi"       // os::os_env
//! import "lib/os/env.loi"   // fine-grained import
//! ```
//!
//! ```sh
//! loi build main.loi -o main --c-source lib/os_shim.c
//! ```
//!
//! `cstr` names are for static environment keys; `os_env` accepts a runtime
//! byte slice. Foreign pointers never enter ordinary Loi values.

extern flow loi_os_pid as getpid
    => i32

extern flow loi_os_has_env
    <- name: cstr
    => bool

extern flow loi_os_env_i32
    <- name: cstr
    <- fallback: i32
    => i32

extern flow loi_os_getenv
    <- name: [u8]
    <-> data: [u8]
    => i64

extern flow loi_os_errno
    => i32

extern flow loi_os_exit as exit
    <- code: i32

open flow os_pid
    => i32
{
    => loi_os_pid()
}

open flow os_has_env
    <- name: cstr
    => bool
{
    => loi_os_has_env(name)
}

/// Read an integer environment variable, using `fallback` when it is absent,
/// empty or malformed.
open flow os_env_i32
    <- name: cstr
    <- fallback: i32
    => i32
{
    => loi_os_env_i32(name, fallback)
}

/// Read an environment variable into a `protect`-owned byte slice. An unset
/// name yields an empty slice. The name is a byte string, not a `cstr`, so it
/// can be assembled at runtime.
open flow os_env
    <- name: [u8]
    => [u8]
{
    mut probe: [u8]
    alloc(-> probe, u8, 1)
    length <- loi_os_getenv(name, <-> probe)
    if length < 0 {
        => ""
    }
    mut value: [u8]
    alloc(-> value, u8, length as u64)
    got <- loi_os_getenv(name, <-> value)
    if got != length {
        => ""
    }
    => value
}

open flow os_errno
    => i32
{
    => loi_os_errno()
}

/// Terminate the process immediately; no Loi cleanup runs.
open flow os_exit
    <- code: i32
{
    loi_os_exit(code)
}

// Short aliases: the module name already supplies the namespace, so the
// repeated prefix is redundant here. The original names remain public for
// broad imports and existing programs.
/// Short alias of `os_pid`.
open flow pid
=> i32
{
    => os_pid()
}

/// Short alias of `os_has_env`.
open flow has_env
<- name: cstr
=> bool
{
    => os_has_env(name)
}

/// Short alias of `os_env_i32`.
open flow env_i32
<- name: cstr
<- fallback: i32
=> i32
{
    => os_env_i32(name, fallback)
}

/// Short alias of `os_env`.
open flow env
<- name: [u8]
=> [u8]
{
    => os_env(name)
}

/// Short alias of `os_errno`.
open flow errno
=> i32
{
    => os_errno()
}

/// Short alias of `os_exit`.
open flow exit
<- code: i32
{
    os_exit(code)
}
