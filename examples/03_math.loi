@package(examples_03_math)
@inc std

main =
{
    double a = 2.0;
    double b = 3.0;
    double p = std.pow(a, b);        /* 8.0 */
    double s = std.sqrt(16.0);       /* 4.0 */
    double f = std.floor(3.9);       /* 3.0 */
    double c = std.ceil(2.1);        /* 3.0 */
    double t = std.tan(0.0);         /* 0.0 */
    double e = std.exp(0.0);         /* 1.0 */
    double l = std.log(1.0);         /* 0.0 */

    std.print_int(std.abs(-99));
    if (p == 8.0 && s == 4.0 && f == 3.0 && c == 3.0 &&
        t == 0.0 && e == 1.0 && l == 0.0) {
        std.print_str("math ok");
    }
    return 0;
}
