@package(examples_18_branch_defines)
/* Metaprogramming: defines are scoped to the branch that declares them.
   A define inside a skipped @if branch is never registered. */
@(define OUTER 1)

@if(0) {
    @(define LEAK 1)
}

@if(OUTER) {
    @(define FEATURE 7)
} @else {
    @(define LEAK 1)
}

@inc std

main =
{
    int r = 0;

@if(defined(LEAK)) {
    r = r + 1000;      /* never taken */
}

@if(FEATURE == 7) {
    r = r + 7;
}

@if(!defined(LEAK)) {
    r = r + 1;
}

    std.print_int(r);
    return r;
}
