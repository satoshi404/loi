@(define ADD(x, y) (x + y))
@(define SQUARE(x) (x * x))
@(define ENABLE_SQUARE 1)
@(include "helpers/lib.loi")

import std

main =
{
    int base = double_it(ADD(1, 2));
@if(ENABLE_SQUARE) {
    int s = SQUARE(base);
} @else {
    int s = base;
}
    loi_print_str("meta ok");
    loi_print_int(s);
    return s;
}
