@package(examples_16_metaprogramming)
@(define ADD(x, y) (x + y))
@(define SQUARE(x) (x * x))
@(define ENABLE_SQUARE 1)
@inc "helpers/lib.loi"

@inc std

main =
{
    int base = double_it(ADD(1, 2));
@if(ENABLE_SQUARE) {
    int s = SQUARE(base);
} @else {
    int s = base;
}
    std.print_str("meta ok");
    std.print_int(s);
    return s;
}
