@inc std

worker = (arg: void*): void* !IO,Alloc
{
    loi_print_str("region block");
    void* p = loi_region_alloc(arg, 8);
    *p = 5;
    loi_print_int(*p);
    return p;
}

main = () -> int !IO,Alloc
{
    region r(64) {
        void* v = worker(r);
        loi_print_int(* (v));
    }
    return 0;
}