package examples_12_effects

@inc std

worker = (arg: void*): void* !IO,Alloc
{
    std.print_str("region block");
    void* p = std.region_alloc(arg, 8);
    *p = 5;
    std.print_int(*p);
    return p;
}

main = () -> int !IO,Alloc
{
    region r(64) {
        void* v = worker(r);
        std.print_int(* (v));
    }
    return 0;
}