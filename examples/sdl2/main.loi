@package(examples_27_sdl2)
@inc std

// SDL2 from loi: a window with a bouncing square.
//
//   Arrow keys steer the square, Esc or closing the window quits.
//
// Build and run (needs clang, LLVM and the SDL2 development files):
//
//   LOI_LDFLAGS="$(sdl2-config --libs)" ./loi examples/27_sdl2.loi --run
//
// SDL is reached through plain `extern` declarations; loi has no SDL headers,
// so the constants below are copied from SDL.h.
//
// SDL_Window* / SDL_Renderer* handles are declared as `long` (same size and
// calling convention as a pointer on 64-bit targets), so they can be compared
// against 0 to detect failure.

@(define SDL_INIT_VIDEO     32)          // 0x20
@(define WINDOWPOS_CENTERED 805240832)   // 0x2FFF0000
@(define WINDOW_SHOWN       4)
@(define EVENT_QUIT         256)         // SDL_QUIT     0x100
@(define EVENT_KEYDOWN      768)         // SDL_KEYDOWN  0x300
@(define KEY_ESCAPE         27)
@(define KEY_RIGHT          1073741903)  // 0x4000004F
@(define KEY_LEFT           1073741904)  // 0x40000050
@(define KEY_DOWN           1073741905)  // 0x40000051
@(define KEY_UP             1073741906)  // 0x40000052

@(define WIDTH  640)
@(define HEIGHT 480)

extern int  SDL_Init(flags: int);
extern void SDL_Quit();
extern ptr  SDL_GetError();
extern long SDL_CreateWindow(title: ptr, x: int, y: int, w: int, h: int, flags: int);
extern void SDL_DestroyWindow(win: long);
extern long SDL_CreateRenderer(win: long, idx: int, flags: int);
extern void SDL_DestroyRenderer(ren: long);
extern int  SDL_SetRenderDrawColor(ren: long, r: int, g: int, b: int, a: int);
extern int  SDL_RenderClear(ren: long);
extern int  SDL_RenderFillRect(ren: long, rc: ptr);
extern void SDL_RenderPresent(ren: long);
extern int  SDL_PollEvent(ev: ptr);
extern void SDL_Delay(ms: int);

// Same layout as SDL_Rect.
struct Rect { int x; int y; int w; int h; }

// The first 56 bytes of SDL_Event, as 14 ints. Only `kind` (the event type, SDL's `type`) and
// `sym` (the key code of an SDL_KEYDOWN event) are read; the rest is padding.
struct Event {
    int kind; int timestamp; int window_id; int key_flags;
    int scancode; int sym; int mod; int unused;
    int pad0; int pad1; int pad2; int pad3; int pad4; int pad5;
}

main = (): int !IO
{
    if (SDL_Init(SDL_INIT_VIDEO) != 0) {
        std.print_str("SDL_Init failed:");
        std.print_str(SDL_GetError());
        return 1;
    }

    long win = SDL_CreateWindow("loi + SDL2", WINDOWPOS_CENTERED, WINDOWPOS_CENTERED,
                               WIDTH, HEIGHT, WINDOW_SHOWN);
    if (win == 0) {
        std.print_str("SDL_CreateWindow failed:");
        std.print_str(SDL_GetError());
        SDL_Quit();
        return 1;
    }

    long ren = SDL_CreateRenderer(win, -1, 0);
    if (ren == 0) {
        std.print_str("SDL_CreateRenderer failed:");
        std.print_str(SDL_GetError());
        SDL_DestroyWindow(win);
        SDL_Quit();
        return 1;
    }

    Event ev;

    Rect box;
    box.x = 40;
    box.y = 40;
    box.w = 64;
    box.h = 64;
    int dx = 4;
    int dy = 3;
    int running = 1;

    while (running) {
        while (SDL_PollEvent(&ev) != 0) {
            int t = ev.kind;
            if (t == EVENT_QUIT) { running = 0; }
            if (t == EVENT_KEYDOWN) {
                int key = ev.sym;
                if (key == KEY_ESCAPE) { running = 0; }
                if (key == KEY_LEFT)   { dx = -4; }
                if (key == KEY_RIGHT)  { dx = 4; }
                if (key == KEY_UP)     { dy = -3; }
                if (key == KEY_DOWN)   { dy = 3; }
            }
        }

        box.x = box.x + dx;
        box.y = box.y + dy;
        if (box.x < 0)                { box.x = 0;                dx = -dx; }
        if (box.x + box.w > WIDTH)    { box.x = WIDTH - box.w;    dx = -dx; }
        if (box.y < 0)                { box.y = 0;                dy = -dy; }
        if (box.y + box.h > HEIGHT)   { box.y = HEIGHT - box.h;   dy = -dy; }

        SDL_SetRenderDrawColor(ren, 20, 20, 30, 255);
        SDL_RenderClear(ren);
        SDL_SetRenderDrawColor(ren, 230, 80, 60, 255);
        SDL_RenderFillRect(ren, &box);
        SDL_RenderPresent(ren);

        SDL_Delay(16);
    }

    SDL_DestroyRenderer(ren);
    SDL_DestroyWindow(win);
    SDL_Quit();
    return 0;
}
