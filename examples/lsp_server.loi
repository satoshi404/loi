// A tiny LSP-style JSON-RPC server written in Loi (Blocks L3, L4 and L5).
// It reads framed requests from stdin and writes framed replies to stdout.
// Build with:
//   loi build examples/lsp_server.loi -o lsp_server \
//       --c-source lib/stdio_shim.c \
//       --c-source lib/process_shim.c \
//       --c-source lib/os_shim.c \
//       --c-source lib/lsp_shim.c
// A zero-length frame or EOF ends the loop.
//
// Diagnostics come from the real compiler: on `didOpen`, `didChange` and
// `didSave` the server writes the client's text and spawns
// `loi check <file> --error-format json`, publishing its stderr as
// `textDocument/publishDiagnostics`. Set LOI_COMPILER to choose the compiler
// binary (default: `loi`). The process is a guarded resource, so its captured
// output is released on every exit path. Build with `lib/lsp_shim.c` as well.

import "../lib/json.loi"
import "../lib/jsonrpc.loi"
import "../lib/lsp.loi"
import "../lib/os.loi"
import "../lib/process.loi"
import "../lib/std.loi"
import "../lib/vec.loi"

/// Strip the `file://` prefix from a document URI.
open flow document_path
    <- uri: [u8]
    => [u8]
{
    if uri.len > 7 {
        prefix <- view(uri, 0, 7)
        if str_eq(prefix, "file://") {
            => view(uri, 7, uri.len)
        }
    }
    => uri
}

/// Return the document text carried by a `didOpen` / `didChange` notification.
/// `didChange` uses the last element of `contentChanges`; the server advertises
/// full-document synchronization, so that element holds the whole buffer.
open flow document_text
    <- doc: JsonDoc
    <- params: i64
    -> found: bool
    => [u8]
{
    found = false
    document <- json_object_get(<- doc, params, "textDocument")
    if document >= 0 and json_kind(<- doc, document) == JsonKind.Object {
        text <- json_object_get(<- doc, document, "text")
        if text >= 0 and json_kind(<- doc, text) == JsonKind.String {
            found = true
            => json_string(<- doc, text)
        }
    }
    changes <- json_object_get(<- doc, params, "contentChanges")
    if changes >= 0 and json_kind(<- doc, changes) == JsonKind.Array {
        count <- json_array_len(<- doc, changes)
        if count > 0 {
            change <- json_array_get(<- doc, changes, count - 1)
            if json_kind(<- doc, change) == JsonKind.Object {
                text <- json_object_get(<- doc, change, "text")
                if text >= 0 and json_kind(<- doc, text) == JsonKind.String {
                    found = true
                    => json_string(<- doc, text)
                }
            }
        }
    }
    => ""
}

/// Run the real compiler and publish its structured diagnostics for `uri`.
open flow publish_diagnostics_for
    <- request: JsonRpcRequest
{
    root <- json_root(<- request.doc)
    params <- json_object_get(<- request.doc, root, "params")
    if params < 0 or json_kind(<- request.doc, params) != JsonKind.Object {
        =>
    }
    document <- json_object_get(<- request.doc, params, "textDocument")
    if document < 0 or json_kind(<- request.doc, document) != JsonKind.Object {
        =>
    }
    uri_node <- json_object_get(<- request.doc, document, "uri")
    if uri_node < 0 {
        =>
    }
    uri <- json_string(<- request.doc, uri_node)
    path <- document_path(uri)

    mut has_text: bool
    text <- document_text(<- request.doc, params, -> has_text)
    if has_text {
        lsp_write_document(path, text)
    }

    mut compiler: [u8] <- os_env("LOI_COMPILER")
    if compiler.len == 0 {
        compiler = "loi"
    }
    mut args: Vec<[u8]>
    vec_new<[u8]>(-> args)
    vec_push<[u8]>(<-> args, "check")
    vec_push<[u8]>(<-> args, path)
    vec_push<[u8]>(<-> args, "--error-format")
    vec_push<[u8]>(<-> args, "json")
    vec_push<[u8]>(<-> args, "--color")
    vec_push<[u8]>(<-> args, "never")

    guard child <- process_spawn_args(compiler, vec_view<[u8]>(<- args, 0, args.len)) {
        diagnostics <- process_stderr(child)
        lsp_publish_diagnostics(uri, diagnostics)
    }
}

/// Dispatch one validated request. Returns false only for `exit`.
open flow dispatch
    <- request: JsonRpcRequest
    => bool
{
    if str_eq(request.method, "initialize") {
        jsonrpc_send_result(
            request.id,
            "{\"capabilities\":{\"textDocumentSync\":1,\"publishDiagnosticsProvider\":true}}"
        )
        => true
    }
    if str_eq(request.method, "shutdown") {
        jsonrpc_send_result(request.id, "null")
        => true
    }
    if str_eq(request.method, "exit") {
        => false
    }
    if str_eq(request.method, "textDocument/didOpen") {
        publish_diagnostics_for(request)
        => true
    }
    if str_eq(request.method, "textDocument/didChange") {
        publish_diagnostics_for(request)
        => true
    }
    if str_eq(request.method, "textDocument/didSave") {
        publish_diagnostics_for(request)
        => true
    }
    // Notifications never get a reply, even when their method is unknown.
    if not request.has_id {
        => true
    }
    jsonrpc_send_error(request.id, -32601, "Method not found")
    => true
}

open flow main
    => i32
{
    while true {
        protect {
            mut body: [u8]
            if not jsonrpc_read_frame(-> body) {
                break
            }
            mut request: JsonRpcRequest
            if not jsonrpc_parse_request(body, -> request) {
                jsonrpc_send_error(0, -32700, "Parse error")
                continue
            }
            if not dispatch(request) {
                break
            }
        }
    }
    => 0
}
